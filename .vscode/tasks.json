{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-srsenb-gdbserver",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/run_srsenb_debug.sh",
      "args": [],
      "options": {
        "env": { "GDBSERVER_PORT": "2345" }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          { "regexp": ".*", "file": 1, "location": 2, "message": 3 }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting srsenb under gdbserver",
          "endsPattern": "Listening on port 2345"
        }
      }
    },
    {
      "label": "stop-srsenb-gdbserver",
      "type": "shell",
      "command": "pkill -f '^gdbserver :2345 .*/srsenb$' || true"
    }
  ]
}
